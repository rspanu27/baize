{
  // Cloudflare Workers static-assets deployment of the editor. No Worker script, no bindings:
  // the site is static files only, which keeps it on the free tier.
  "name": "baize",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
  },
}
